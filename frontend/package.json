{
  "name": "fastapibookstore-frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "permission": "sudo chown -R $USER:$USER /home/igor7786/PycharmProjects/PythonProject/AsrtoFastapi/frontend",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "app": "sudo env \"PATH=$PATH\" bun --bun run dev -- --host",
    "worker": "bun --bun run src/lib/queues/email-workers.ts",
    "bun:dev": "bun run --parallel app worker",
    "bun:build:hono": "bun --bun run astro build && sudo /home/igor7786/.bun/bin/bun --bun ./src/hono-server.js",
    "bun:build:bun": "bun --bun run astro build && sudo /home/igor7786/.bun/bin/bun --bun ./src/bun-server.js",
    "generate:contract": "bun run src/lib/hono-adapter/orpc/open-api-docs/generate-contract-json.ts",
    "generate:auth": "bunx --bun @better-auth/cli@latest generate --output ./db/auth-schema.ts",
    "db:generate:migrations": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "bunx prettier --write \"./**/*.{ts,tsx,js,jsx,json,css,scss,md,astro, html, mjs}\"",
    "ts:check": "bunx tsc --noEmit",
    "start:workers": "bun --workers=8 run src/hono-server.js",
    "benchmark:1": "autocannon -c 100 -d 5 http://localhost:4321/api/test",
    "benchmark:2": "autocannon -c 500 -d 5 http://localhost:4321/api/rpc/get-planets",
    "benchmark:3": "autocannon -c 1000 -d 5 http://localhost:4321/api/todos",
    "benchmark:4": "autocannon -c 100 -d 5 http://localhost:4321/api/todos",
    "benchmark:5": "autocannon -c 100 -d 5 http://localhost:4321/api/time",
    "benchmark:6": "autocannon -c 100 -d 5 http://localhost:4321/dashboard",
    "benchmark:7": "autocannon -c 100 -d 5 http://localhost:4321/api/hash"
  },
