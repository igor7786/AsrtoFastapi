{
  "name": "fastapibookstore-frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bun:dev": "bun --bun run dev -- --host",
    "bun:build": "bun --bun run astro build && bun --bun run ./src/hono-server.js",
    "generate:auth": "bunx --bun @better-auth/cli@latest generate --output ./db/auth-schema.ts",
    "db:generate:migrations": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "bunx prettier --write \"./**/*.{ts,tsx,js,jsx,json,css,scss,md,astro}\"",
    "start:workers": "bun --workers=8 run src/hono-server.js",
    "benchmark:1": "autocannon -c 100 -d 5 http://localhost:4321/api/test",
    "benchmark:2": "autocannon -c 500 -d 5 http://localhost:4321/api/rcp/get-planets",
    "benchmark:3": "autocannon -c 1000 -d 5 http://localhost:4321/api/todos",
    "benchmark:4": "autocannon -c 100 -d 5 http://localhost:4321/api/todos",
    "benchmark:5": "autocannon -c 100 -d 5 http://localhost:4321/api/time",
    "benchmark:6": "autocannon -c 100 -d 5 http://localhost:4321/dashboard",
    "benchmark:7": "autocannon -c 100 -d 5 http://localhost:4321/api/hash"
  },
