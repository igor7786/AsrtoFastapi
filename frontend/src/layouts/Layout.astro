---
import themeScript from '@/scripts/theme-checker.js?raw';
import persistentScript from '@/scripts/astro-transition-client-theme-persistent.js?raw';
import { Toaster } from '@rcomp/ui/sonner';
const { title } = Astro.props;
import '../styles/global.css';
import CacheManager from '@rcomp/CacheManager';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script set:html={themeScript} />
  </head>
  <body>
    <div class="bg-background min-h-screen">
      <slot name="header" />
      <slot name="main" />
      <slot name="footer" />

      <Toaster client:load />
      <CacheManager client:load />
    </div>
  </body><!-- Inline the theme-checker.js script -->
</html>
