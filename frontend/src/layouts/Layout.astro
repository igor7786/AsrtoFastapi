---
import themeScript from '@/scripts/theme-checker.js?raw';
import persistentScript from '@/scripts/astro-transition-client-theme-persistent.js?raw';
import { ClientRouter } from 'astro:transitions';
const { title } = Astro.props;
import '../styles/global.css';
import CacheManager from '@/components/reactcomp/CacheManager';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script set:html={themeScript} />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <CacheManager client:only="react" />
  </body><!-- Inline the theme-checker.js script -->
  <script is:inline set:html={persistentScript} data-astro-rerun />
</html>
