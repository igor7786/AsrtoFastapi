---
// src/pages/docs.astro
import ApiDocs from '@rcomp/ApiDocs';
import Layout from '@/layouts/Layout.astro';
import ThemeToggleShell from '@rcomp/ThemeModeToogle';
import { SkeletonPage } from '@rcomp/LoadingSkeleton';
---

<Layout title="Api Docs">
  <main slot="main">
    <header>
      <ThemeToggleShell className="absolute top-4 right-4" client:load />
      <!-- Logo, nav menu, site title -->
    </header>
    <ApiDocs client:idle>
      <div slot="fallback">
        <SkeletonPage />
      </div><ApiDocs />
    </ApiDocs>
  </main>
</Layout>
