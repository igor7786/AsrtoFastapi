---
import { SkeletonPage } from '@rcomp/LoadingSkeleton';
import GetTodoById from '@rcomp/TESTORCP';
import Layout from '@/layouts/Layout.astro';
import { router } from '@/lib/hono-adapter/orpc/routes/router';
import { call } from '@orpc/server';

const findId: string = '1';

let result = null;
let errorMessage: string  = '';

try {
  result = await call(
    router.todos.getTodo,
    { id: findId },
    { context: Astro.locals }
  );
} catch (err: any) {
  if (err.code === 'BAD_REQUEST' || err.code === 'NOT_FOUND') {
    console.error('ORPC Error:', err.message);
    errorMessage = err.message;
  } else {
    console.error("Unexpected error:", err);
    errorMessage = "Unexpected error";// fallback anyway
  }
}
---


<Layout title="Login">
  <!--<Page client:visible />-->
  <GetTodoById result={result} findId={findId} err ={errorMessage} client:load>
    <div slot="fallback">
      <SkeletonPage />
    </div>
  </GetTodoById>
</Layout>
