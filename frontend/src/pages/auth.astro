---
import Layout from '@/layouts/Layout.astro';
import { SkeletonPage } from '@rcomp/LoadingSkeleton';
import TabsAuth from '@rcomp/shadcn-studio/tabs/Auth';
import { tabsUrlSchema } from '@/lib/types-schemas-validator/pages-other/tabs.url';
const title = 'Auth';
let sign = Astro.url.searchParams.get('tab') as string;

// Validate tab query param
try {
  sign = tabsUrlSchema.parse(sign);
} catch {
  sign = 'signin'; // fallback
  return Astro.redirect(`/auth?tab=${sign}`, 302); // redirect
}
---

<Layout title={title}>
  <!--<Page client:visible />-->
  <main slot="main">
    <TabsAuth props={sign} client:only="react">
      <div slot="fallback">
        <SkeletonPage />
      </div>
    </TabsAuth>
  </main>
</Layout>
