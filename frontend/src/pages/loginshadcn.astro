---
import Layout from '@/layouts/Layout.astro';
import { SkeletonPage } from '@rcomp/LoadingSkeleton';
import { LoginForm } from '@rcomp/LoginForm';
import ThemeToggleShell from '@rcomp/ThemeModeToogle';
// if (Astro.locals.user) {
//   console.log('Astro.locals.user:', Astro.locals.user);
//   return Astro.redirect('/');
// }
---

<Layout title="Login-shadcn">
  <!--<Page client:visible />-->
  <main>
    <header>
      <ThemeToggleShell className="absolute top-4 right-4" client:only="react" />
      <!-- Logo, nav menu, site title -->
    </header>
    <LoginForm client:only="react">
      <div slot="fallback">
        <SkeletonPage />
      </div>
    </LoginForm>
    <footer>
      <!-- Footer info, links, copyrights -->
    </footer>
  </main>
</Layout>
