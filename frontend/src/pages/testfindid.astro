---
import { SkeletonPage } from '@rcomp/LoadingSkeleton';
import GetTodoById from '@rcomp/TESTORCP';
import Layout from '@/layouts/Layout.astro';
import { router } from '@hono-adapt/orpc/routes/router';
import { call } from '@orpc/server';
import { dehydrate } from '@tanstack/react-query';
import { getQueryClient } from '@/lib/tan-stack/tanstack-query';
import QueryProvider from '@/lib/tan-stack/SsrQueryProvider';
const findId: string = '1';

const fetchTodo = async () => {
  try {
    const todo = await call(router.todos.getTodo, { id: findId }, { context: Astro.locals });
    return todo;
  } catch (err: any) {
    throw new Error(err?.message || 'Unknown error');
  }
};

const queryClient = getQueryClient();

await queryClient.prefetchQuery({
  queryKey: ['todo', findId],
  queryFn: fetchTodo,
});

// Dehydrate the query client for client hydration
const dehydratedState = dehydrate(queryClient);
---

<Layout title="Login">
  <div class="bg-muted flex min-h-svh flex-col items-center justify-center gap-6 p-6 md:p-10">
    <QueryProvider client:load dehydratedState={dehydratedState}>
      <GetTodoById findId={findId} client:load>
        <div slot="fallback">
          <SkeletonPage />
        </div>
      </GetTodoById>
    </QueryProvider>
  </div>
</Layout>
