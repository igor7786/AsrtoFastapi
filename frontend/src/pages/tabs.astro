---
import Layout from '@/layouts/Layout.astro';
import AnimatedTabsDemo from '@/components/shadcn-studio/tabs/tabs-27';
import { tabsUrlSchema } from '@/lib/types-schemas-validator/pages-other/tabs-url';

const title = 'Login';

let sign = Astro.url.searchParams.get('tab') as string;

// Validate tab query param
try {
  sign = tabsUrlSchema.parse(sign);
} catch {
  sign = 'signin'; // fallback
}

// Optional fallback redirect if no tab was specified
if (Astro.url.href.endsWith('/tabs') || Astro.url.href.endsWith('/tabs/')) {
  return Astro.redirect(`/tabs?tab=${sign}`, 302);
}
---

<Layout title={title}>
  <div class="bg-muted flex min-h-svh flex-col items-center justify-center gap-6 p-6 md:p-10">
    <AnimatedTabsDemo props={sign} client:load />
  </div>
</Layout>
