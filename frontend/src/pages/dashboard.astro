---
import Page from '@rcomp/Page';
import { SkeletonPage } from '@rcomp/LoadingSkeleton';
import Layout from '@layout/Layout.astro';
import data from '@rcomp/data.json';
---

<Layout>
  <Page data={data} client:only="react">
    <div slot="fallback">
      <SkeletonPage />
    </div>
  </Page>
</Layout>
